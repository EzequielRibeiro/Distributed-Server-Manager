[Unit]
Description=Capivara DSM privileged Agent updater
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
# Prepare once outside the sandbox; the updater itself never replaces the inode.
ExecStartPre=+/usr/bin/python3 -I /opt/capivara-agent/runtime/game_uptime_privileged_flock.py --provision-updater-admission
ExecStart=/usr/bin/python3 /opt/capivara-agent/updater/updater.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/capivara-agent /var/lib/capivara-agent /etc/capivara-agent /etc/systemd/system /etc/polkit-1/rules.d /usr/local/bin
