[Unit]
Description=Capivara Agent instance service provisioner
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /opt/capivara-agent/provisioner/instance_provisioner.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/systemd/system /var/lib/capivara-agent

