[Unit]
Description=Capivara DSM Linux Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=capivara-agent
Group=capivara-agent
ExecStart=/usr/bin/python3 /opt/capivara-agent/runtime/agent.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/capivara-agent /var/lib/capivara-agent

[Install]
WantedBy=multi-user.target
