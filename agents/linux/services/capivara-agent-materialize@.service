[Unit]
Description=Capivara Agent privileged materializer for %i
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
# Runtime identity prepares the common lock at Agent startup. A helper
# invoked independently must also prepare it after a reboot, before SH.
ExecStartPre=+/usr/bin/python3 -I /opt/capivara-agent/runtime/game_uptime_privileged_flock.py --provision
Environment=DSM928_AGENT_PRIVILEGED_FLOCK=1
ExecStart=/usr/bin/python3 /opt/capivara-agent/privileged/materialize_instance.py %i
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/systemd/system /var/lib/capivara-agent/privileged-materialization /var/lib/capivara-agent/game-data /var/lib/capivara-instances
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
