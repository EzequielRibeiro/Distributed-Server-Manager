[Unit]
Description=Capivara Agent privileged backup restore for %i
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
# Runtime identity prepares the common lock at Agent startup. A helper
# invoked independently must also prepare it after a reboot, before SH.
ExecStartPre=+/usr/bin/python3 -I /opt/capivara-agent/runtime/game_uptime_privileged_flock.py --provision
Environment=DSM928_AGENT_PRIVILEGED_FLOCK=1
Environment=CAPIVARA_AGENT_ROOT=/opt/capivara-agent
Environment=CAPIVARA_AGENT_STATE_DIR=/var/lib/capivara-agent
Environment=CAPIVARA_AGENT_CONFIG=/etc/capivara-agent/agent.json
Environment=CAPIVARA_AGENT_RESULT_USER=capivara-agent
ExecStart=/usr/bin/python3 /opt/capivara-agent/privileged/restore_instance_backup.py %i
TimeoutStartSec=3550
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/capivara-agent /var/lib/capivara-instances
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
