# Capivara is deployed on Linux. Keep executable/configuration text portable.
*.sh      text eol=lf
*.service text eol=lf
*.py      text eol=lf
*.json    text eol=lf
*.conf    text eol=lf
*.cfg     text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.sql     text eol=lf
version   text eol=lf

# Preserve binary artifacts byte-for-byte.
*.jar binary
*.pyc binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.gz binary

# Capivara CLI executables without extension
bin/dsm text eol=lf
bin/dsm-alerts text eol=lf
bin/dsm-runtime text eol=lf
