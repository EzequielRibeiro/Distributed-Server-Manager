[Unit]
Description=DSM Notification Center
After=dsm-notification-engine.service
Wants=dsm-notification-engine.service

[Service]
Type=oneshot
User={{DSM_USER}}
Environment=DSM_ROOT=/opt/dsm
WorkingDirectory=/opt/dsm
ExecStart=/opt/dsm/dashboard/notifications/notification_center.sh
StandardOutput=journal
StandardError=journal
