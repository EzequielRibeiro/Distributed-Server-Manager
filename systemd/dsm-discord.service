# =============================================================
# DSM Discord Integration Engine
#
# Arquivo:
#   /etc/systemd/system/dsm-discord.service
#
# Versão:
#   DSM v1.2.0
#
# =============================================================

[Unit]
Description=DSM Discord Integration Engine
Documentation=https://github.com/seu-repositorio/dsm
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{DSM_USER}}
Group={{DSM_GROUP}}
WorkingDirectory=/opt/dsm
Environment=DSM_ROOT=/opt/dsm
ExecStart=/opt/dsm/core/discord_sender.sh daemon
Restart=always
RestartSec=5
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
