[Unit]
Description=Capivara DSM Automation and Broadcast Worker
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/opt/dsm

[Service]
Type=simple
User={{DSM_USER}}
Group={{DSM_GROUP}}
Environment=DSM_ROOT=/opt/dsm
EnvironmentFile=-/opt/dsm/config/dsm.conf
EnvironmentFile=-/etc/default/dsm-dashboard
WorkingDirectory=/opt/dsm
ExecStart=/usr/bin/python3 /opt/dsm/dashboard/workers/automation_worker.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=capivara-automation-worker

[Install]
WantedBy=multi-user.target
