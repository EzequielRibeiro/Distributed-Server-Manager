# =============================================================
# Capivara DSM Dashboard Worker
# =============================================================

[Unit]
Description=Capivara DSM Dashboard Worker
After=network.target
RequiresMountsFor=/opt/dsm

[Service]
Type=simple
User={{DSM_USER}}
Group={{DSM_GROUP}}
WorkingDirectory=/opt/dsm
Environment=DSM_ROOT=/opt/dsm
Environment=HOME=/opt/dsm
Environment=CAPIVARA_STEAM_HOME=/opt/dsm
# Detect upstream Workshop changes; per-content policy still governs whether updates run.
# A later systemd drop-in may explicitly override this to 0.
Environment=DSM_WORKSHOP_UPDATE_DETECTION_ENABLED=1
# Repair the bounded Hybrid YARA-X state subtree before dropping privileges.
ExecStartPre=+/usr/bin/python3 /opt/dsm/dashboard/workers/prepare_hybrid_yarax_state.py --root /opt/dsm --user {{DSM_USER}} --group {{DSM_GROUP}}
ExecStart=/bin/bash /opt/dsm/dashboard/workers/worker.sh
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=capivara-dashboard-worker

[Install]
WantedBy=multi-user.target
