[Unit]
Description=DSM System Metrics Worker
After=network.target

[Service]
Type=simple
User={{DSM_USER}}
Group={{DSM_GROUP}}
Environment=DSM_ROOT=/opt/dsm
Environment=DSM_INTERVAL=5
EnvironmentFile=/opt/dsm/config/context.conf
ExecStart=/opt/dsm/dashboard/workers/metrics_worker.sh
Restart=always
RestartSec=5
WorkingDirectory=/opt/dsm
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
