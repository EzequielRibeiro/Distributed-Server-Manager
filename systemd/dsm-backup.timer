[Unit]
Description=DSM Backup Automático Diário

[Timer]
# Executa todos os dias às 03:00
OnCalendar=*-*-* 03:00:00

# Executa caso o servidor estivesse desligado no horário
Persistent=true

# Aguarda 5 minutos após o boot antes de disparar pendências
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
