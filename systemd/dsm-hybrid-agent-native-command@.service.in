[Unit]
Description=Capivara DSM Hybrid Agent privileged native command for %i
After=local-fs.target network.target

[Service]
Type=oneshot
User=root
Group=root
Environment=CAPIVARA_AGENT_ROOT=@DSM_ROOT@/agents/linux
Environment=CAPIVARA_AGENT_STATE_DIR=@DSM_ROOT@/runtime/hybrid-agent-state
Environment=CAPIVARA_AGENT_CONFIG=@DSM_ROOT@/runtime/hybrid-agent-state/agent.json
Environment=CAPIVARA_AGENT_RESULT_USER=@DSM_USER@
ExecStart=/usr/bin/python3 @DSM_ROOT@/agents/linux/privileged/native_command.py %i

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=@DSM_ROOT@/runtime/hybrid-agent-state
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
