[Unit]
Description=Capivara DSM Dashboard Web Interface
After=network-online.target dsm-controller-log-reader.service dsm-controller-service-topology.service
Wants=network-online.target dsm-controller-log-reader.service dsm-dashboard-worker.service dsm-alert-engine.service
Requires=dsm-controller-service-topology.service
RequiresMountsFor=/opt/dsm

[Service]
Type=simple
User={{DSM_USER}}
Group={{DSM_GROUP}}
Environment=DSM_ROOT=/opt/dsm
EnvironmentFile=-/opt/dsm/config/dsm.conf
WorkingDirectory=/opt/dsm/dashboard
# Composition base retained by dashboard/server_part18.py: dashboard/server_part17.py
ExecStart=/usr/bin/python3 /opt/dsm/dashboard/server_part18.py
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=capivara-dashboard

[Install]
WantedBy=multi-user.target
