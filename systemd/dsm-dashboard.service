[Unit]
Description=Capivara DSM Dashboard Web Interface
After=network-online.target dsm-controller-log-reader.service dsm-controller-service-topology.service
Wants=network-online.target dsm-controller-log-reader.service dsm-dashboard-worker.service dsm-alert-engine.service
Requires=dsm-controller-service-topology.service
RequiresMountsFor=/opt/dsm

[Service]
Type=simple
User={{DSM_USER}}
Group={{DSM_GROUP}}
Environment=DSM_ROOT=/opt/dsm
# Enable the shared request lock for installed Controller HTTP mutations.
# A maintenance transaction still requires independent distributed fencing.
Environment=DSM928_CONTROLLER_AGENT_HTTP_FLOCK=1
EnvironmentFile=-/opt/dsm/config/dsm.conf
WorkingDirectory=/opt/dsm/dashboard
# Provision stable Controller lock and empty persistent evidence storage only.
# No hold, receipt, key, inventory or live update permission is created.
ExecStartPre=+/usr/bin/python3 /opt/dsm/dashboard/workers/prepare_maintenance_worker_locks.py --user {{DSM_USER}} --group {{DSM_GROUP}} --controller-only
# Composition chain retained by dashboard/server_part22.py: Database Intelligence -> YARA-X admin -> server_part20.py -> server_part19.py -> server_part18.py -> server_part17.py
ExecStart=/usr/bin/python3 /opt/dsm/dashboard/server_part22.py
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=capivara-dashboard

[Install]
WantedBy=multi-user.target
