[Unit]
Description=DSM Notification Engine
After=dsm-dashboard-worker.service
Wants=dsm-dashboard-worker.service

[Service]
Type=oneshot
User={{DSM_USER}}
Environment=DSM_ROOT=/opt/dsm
WorkingDirectory=/opt/dsm
ExecStart=/opt/dsm/dashboard/notifications/notification_engine.sh
StandardOutput=journal
StandardError=journal
