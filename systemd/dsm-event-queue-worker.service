[Unit]
Description=Capivara DSM Universal Event Queue Worker
After=network.target
RequiresMountsFor=/opt/dsm

[Service]
Type=simple
User={{DSM_USER}}
Group={{DSM_GROUP}}
Environment=DSM_ROOT=/opt/dsm
WorkingDirectory=/opt/dsm
ExecStart=/opt/dsm/dashboard/workers/event_queue_worker.sh run
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=capivara-event-queue-worker

[Install]
WantedBy=multi-user.target
