[Unit]
Description=Capivara DSM Agent Monitor (watchdog, health and resources)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/opt/dsm

[Service]
Type=simple
User={{DSM_USER}}
Group={{DSM_GROUP}}
Environment=DSM_ROOT=/opt/dsm
WorkingDirectory=/opt/dsm
ExecStart=/opt/dsm/bin/dsm monitor daemon
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=capivara-monitor

[Install]
WantedBy=multi-user.target
