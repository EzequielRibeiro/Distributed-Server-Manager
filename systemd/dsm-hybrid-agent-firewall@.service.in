[Unit]
Description=Capivara DSM Hybrid Agent managed firewall reconciler for %i
After=network-pre.target

[Service]
Type=oneshot
User=root
Group=root
# Prepare the same stable host-local witness used by standalone root helpers.
# The execution path only opens it read-only; retain existing sandbox policy.
ExecStartPre=+/usr/bin/python3 -I @DSM_ROOT@/agents/linux/runtime/game_uptime_privileged_flock.py --provision
Environment=DSM928_AGENT_PRIVILEGED_FLOCK=1
Environment=CAPIVARA_AGENT_ROOT=@DSM_ROOT@/agents/linux
Environment=CAPIVARA_AGENT_STATE_DIR=@DSM_ROOT@/runtime/hybrid-agent-state
ExecStart=/usr/bin/python3 @DSM_ROOT@/agents/linux/privileged/reconcile_firewall.py %i
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/ufw @DSM_ROOT@/runtime/hybrid-agent-state/privileged-firewall
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
