[Unit]
Description=DSM Discord Notification Worker
After=dsm-notification-center.service
Wants=dsm-notification-center.service

[Service]
Type=simple
User={{DSM_USER}}
Environment=DSM_ROOT=/opt/dsm
WorkingDirectory=/opt/dsm
ExecStart=/opt/dsm/dashboard/notifications/discord_worker.sh
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
