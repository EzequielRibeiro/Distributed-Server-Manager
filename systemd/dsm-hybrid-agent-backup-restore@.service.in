[Unit]
Description=Capivara DSM Hybrid Agent privileged backup restore for %i
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
# Prepare the same stable host-local witness used by standalone root helpers.
# The execution path only opens it read-only; retain existing sandbox policy.
ExecStartPre=+/usr/bin/python3 -I @DSM_ROOT@/agents/linux/runtime/game_uptime_privileged_flock.py --provision
Environment=DSM928_AGENT_PRIVILEGED_FLOCK=1
Environment=CAPIVARA_AGENT_ROOT=@DSM_ROOT@/agents/linux
Environment=CAPIVARA_AGENT_STATE_DIR=@DSM_ROOT@/runtime/hybrid-agent-state
Environment=CAPIVARA_AGENT_CONFIG=@DSM_ROOT@/runtime/hybrid-agent-state/agent.json
Environment=CAPIVARA_AGENT_RESULT_USER=@DSM_USER@
Environment=CAPIVARA_AGENT_MODE=hybrid
Environment=CAPIVARA_DSM_ROOT=@DSM_ROOT@
Environment=CAPIVARA_FIREWALL_UNIT_TEMPLATE=dsm-hybrid-agent-firewall@{instance_id}.service
ExecStart=/usr/bin/python3 @DSM_ROOT@/agents/linux/privileged/restore_instance_backup.py %i
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=@DSM_ROOT@/runtime/hybrid-agent-state @DSM_ROOT@/runtime/hybrid-instance-storage
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
