[Unit]
Description=Capivara DSM Controller Service Topology Reconciler
After=local-fs.target
Before=dsm-dashboard-worker.service dsm-alert-engine.service dsm-dashboard.service
Conflicts=dsm-monitor.service dsm-scheduler.service dsm-automation-worker.service
RequiresMountsFor=/opt/dsm

[Service]
Type=oneshot
ExecStartPre=/usr/bin/python3 -E -s -B /opt/dsm/agents/linux/runtime/game_uptime_privileged_flock.py --provision-with-state
ExecStart=/usr/bin/python3 -E -s -B /opt/dsm/agents/linux/runtime/game_uptime_privileged_flock.py --run-controller-topology
RemainAfterExit=yes
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
