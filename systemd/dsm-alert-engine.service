[Unit]
Description=Capivara DSM Database Alert Engine
After=network.target dsm-dashboard-worker.service
Wants=dsm-dashboard-worker.service
RequiresMountsFor=/opt/dsm

[Service]
Type=simple
User={{DSM_USER}}
Group={{DSM_GROUP}}
Environment=DSM_ROOT=/opt/dsm
WorkingDirectory=/opt/dsm
ExecStart=/usr/bin/python3 /opt/dsm/monitor/alert_engine.py
Restart=always
RestartSec=10
TimeoutStartSec=30
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=capivara-alert-engine

[Install]
WantedBy=multi-user.target
