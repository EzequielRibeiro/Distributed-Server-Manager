#!/bin/bash
# =============================================================
# bin/dsm-compat - camada interna de compatibilidade do Capivara
#
# Este arquivo preserva implementação legada/baixo nível, mas NÃO é uma
# CLI pública. Toda ajuda e orientação ao operador deve anunciar `cap`.
#
# CLI pública:
#   cap help
#   cap help --all
#
# Fonte única de configuração:
#   /opt/dsm/config/dsm.conf
# =============================================================

set -Eeuo pipefail

# Uma atualização pode substituir /opt/dsm enquanto um terminal ainda o usa
# como diretório atual. Recupere o shell antes de executar qualquer comando
# que dependa de getcwd().
if ! pwd -P >/dev/null 2>&1
then
    cd /opt 2>/dev/null || cd /
fi

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
export DSM_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

BOOTSTRAP="${DSM_ROOT}/core/bootstrap.sh"
if [ ! -f "${BOOTSTRAP}" ]
then
    echo "Bootstrap não encontrado:"
    echo "${BOOTSTRAP}"
    exit 1
fi

# shellcheck source=/dev/null
source "${BOOTSTRAP}"

# Python management commands consume the same runtime database contract.
export DSM_DATABASE_DRIVER DSM_DATABASE DSM_DATABASE_HOST DSM_DATABASE_PORT
export DSM_DATABASE_NAME DSM_DATABASE_USER DSM_DATABASE_PASSWORD_FILE
export DSM_DATABASE_TLS

update_command()
{
    local ACTION="${1:-}"
    local module="${DSM_ROOT}/update-manager/update-manager.sh"

    if [[ ! -f "${module}" ]]
    then
        echo "Update Manager não encontrado:" >&2
        echo "${module}" >&2
        return 1
    fi

    # shellcheck source=/dev/null
    source "${module}"

    case "${ACTION}" in
        check) dsm_update_check ;;
        run) dsm_update_run ;;
        history) dsm_update_history ;;
        *)
            echo "Uso:" >&2
            echo "  cap update check" >&2
            echo "  cap update run" >&2
            echo "  cap update history" >&2
            return 2
            ;;
    esac
}

section()
{
    echo
    echo "============================================================"
    echo "$1"
    echo "============================================================"
    echo
}

usage()
{
cat <<'EOF'

============================================================
 Capivara Distributed Server Manager
 Camada interna de compatibilidade / baixo nível
============================================================

Uso público:
  cap <comando> [argumentos]

Ajuda canônica:
  cap help
  cap help --all

Servidor de jogo:
  cap server start <game> <instance>
  cap server stop <game> <instance>
  cap server restart <game> <instance>
  cap server status <game> <instance>
  cap server validate <game> <instance>

Diagnóstico:
  cap doctor run
  cap doctor status
  cap monitor

Mods:
  cap mods install ...
  cap mods update ...
  cap mods verify ...
  cap mods rollback ...
  cap mods keys ...
  cap mods state ...

Backup local:
  cap backup create
  cap backup restore <arquivo>
  cap backup snapshot

Configuração e atualização:
  cap config show
  cap update check
  cap update run
  cap update history

Steam:
  cap steam auth

Runtime:
  cap runtime <comando> [argumentos]

Usuários:
  cap user add <usuario> <admin|operator|controller|customer> [scope]
  cap user remove <usuario>
  cap user passwd <usuario>
  cap user list

Games:
  cap game install <environment-id> <version|latest|current>
  cap game show <environment-id> <version|latest|current>

Catálogo e conteúdo:
  cap catalog runtime list [game]
  cap catalog runtime show <runtime-id>
  cap catalog runtime prepare <runtime-id> <version>
  cap content list [game]
  cap content show <content-id>
  cap content plan <request.json> <instance-path>
  cap content install <request.json> <instance-path>
  cap content remove <instance-path> <content-id>
  cap content list-installed <instance-path>
  cap content verify <instance-path>
  cap content rollback <instance-path>
  cap compatibility check <request.json>

  Use --json nos comandos catalog/content/compatibility quando suportado
  para saída estruturada destinada a scripts e APIs.

Agents - portas:
  cap agent ports show <agent-id>
  cap agent ports set <agent-id> <inicio> <fim> [--protocol tcp|udp|both]
  cap agent ports check <agent-id>

Database:
  cap database init
  cap database migrate
  cap database status
  cap database check
  cap database backup <arquivo>
  cap database restore <arquivo> --confirm-restore

Operação:
  cap operations readiness

Manutenção de instâncias:
  cap instance bootstrap ...
  cap instance bootstrap-status ...
  cap instance purge-orphan <instance-id>

Administração atual de Controller, Customer, Contract, Agent e Instance:
  use sempre a CLI pública `cap`.

============================================================
EOF
}

server_command()
{
    local ACTION="${1:-}"
    local GAME="${2:-}"
    local INSTANCE="${3:-}"

    if [[ -n "${GAME}" ]]
    then
        export GAME_ID="${GAME}"
    fi

    if [[ -n "${INSTANCE}" ]]
    then
        export DSM_INSTANCE_ID="${INSTANCE}"
    fi

    case "${ACTION}" in
        start|stop|restart|status|validate|publish)
            if [[ -z "${GAME_ID:-}" ]]
            then
                echo "GAME_ID não definido."
                echo
                echo "Uso:"
                echo "  cap server ${ACTION} <game> <instance>"
                return 1
            fi

            if [[ -z "${DSM_INSTANCE_ID:-}" ]]
            then
                echo "DSM_INSTANCE_ID não definido."
                echo
                echo "Uso:"
                echo "  cap server ${ACTION} <game> <instance>"
                return 1
            fi
            ;;
    esac

    case "${ACTION}" in
        start)
            source "${DSM_ROOT}/server/start.sh"
            server_start
            ;;
        stop)
            source "${DSM_ROOT}/server/stop.sh"
            server_stop
            ;;
        restart)
            source "${DSM_ROOT}/server/restart.sh"
            server_restart
            ;;
        status)
            source "${DSM_ROOT}/server/status.sh"
            server_status
            ;;
        validate)
            source "${DSM_ROOT}/server/validate.sh"
            server_validate
            ;;
        publish)
            source "${DSM_ROOT}/core/runtime/publisher.sh"
            publish_server_state
            ;;
        *)
            usage
            return 1
            ;;
    esac
}

doctor_command()
{
    case "${1:-run}" in
        run)
            source "${DSM_ROOT}/doctor/runner.sh"
            ;;
        status)
            if [[ -f "${DSM_ROOT}/core/lib/runtime.sh" ]]
            then
                source "${DSM_ROOT}/core/lib/runtime.sh"
                runtime_init
                runtime_get doctor
            else
                echo "Runtime indisponível."
                return 1
            fi
            ;;
        *)
            echo
            echo "Uso:"
            echo " cap doctor run"
            echo " cap doctor status"
            echo
            return 1
            ;;
    esac
}

monitor_command()
{
    local module="${DSM_ROOT}/monitor/diagnose.sh"

    if [[ ! -f "${module}" ]]
    then
        log_error "Módulo Monitor não encontrado:"
        echo "${module}"
        return 1
    fi

    source "${module}"
    diagnose_run "$@"
}

mods_dispatch()
{
    local module="${DSM_ROOT}/mods/mods.sh"

    if [[ ! -f "${module}" ]]
    then
        log_error "Dispatcher de Mods não encontrado:"
        echo "${module}"
        return 1
    fi

    bash "${module}" "$@"
}

backup_command()
{
    case "${1:-}" in
        create)
            source "${DSM_ROOT}/backup/create.sh"
            backup_create
            ;;
        restore)
            source "${DSM_ROOT}/backup/restore.sh"
            restore_backup "$2"
            ;;
        snapshot)
            source "${DSM_ROOT}/backup/snapshot.sh"
            snapshot_create
            ;;
        *)
            echo
            echo "Uso:"
            echo " cap backup create"
            echo " cap backup restore arquivo"
            echo " cap backup snapshot"
            ;;
    esac
}

config_command()
{
    case "${1:-}" in
        show)
            config_show
            ;;
        *)
            echo
            echo "Uso:"
            echo " cap config show"
            ;;
    esac
}

game_command()
{
    local ACTION="${1:-}"
    shift || true

    case "${ACTION}" in
        install|show)
            exec "${DSM_ROOT}/installer/install_selection.sh" "${ACTION}" "$@"
            ;;
        *)
            echo "Uso: cap game install|show <environment-id> <version|latest|current>" >&2
            return 2
            ;;
    esac
}

steam_command()
{
    local ACTION="${1:-}"
    local PROVIDER="${DSM_ROOT}/installer/providers/steam.sh"
    local CONF="${DSM_ROOT}/config/providers/steam.conf"

    case "${ACTION}" in
        auth)
            if [[ ! -f "${PROVIDER}" ]]
            then
                echo "Provider Steam não encontrado:" >&2
                echo "${PROVIDER}" >&2
                return 1
            fi

            if [[ -f "${CONF}" ]]
            then
                unset DSM_STEAM_USER 2>/dev/null || true
                unset STEAM_USER 2>/dev/null || true
                # shellcheck source=/dev/null
                source "${CONF}"
            fi

            local USER="${DSM_STEAM_USER:-${STEAM_USER:-}}"
            if [[ -z "${USER}" ]]
            then
                echo "Usuário Steam não configurado." >&2
                echo "Configure DSM_STEAM_USER em:" >&2
                echo "${CONF}" >&2
                return 1
            fi

            # shellcheck source=/dev/null
            source "${PROVIDER}"
            steam_provider_authenticate "${USER}"
            ;;
        *)
            echo "Uso: cap steam auth" >&2
            return 2
            ;;
    esac
}

catalog_command()
{
    exec "${DSM_ROOT}/installer/catalog.sh" "$@"
}

database_command()
{
    exec python3 "${DSM_ROOT}/database/manager.py" \
        --root "${DSM_ROOT}" \
        "$@"
}

instance_command()
{
    case "${1:-}" in
        bootstrap|bootstrap-status)
            exec python3 "${DSM_ROOT}/database/registry.py" \
                --root "${DSM_ROOT}" \
                "$@"
            ;;
        create-aurora)
            exec python3 "${DSM_ROOT}/database/registry.py" \
                --root "${DSM_ROOT}" \
                create-aurora
            ;;
        purge-orphan)
            shift
            if [[ $# -ne 1 ]]
            then
                echo "Uso: cap instance purge-orphan <instance-id>" >&2
                return 2
            fi
            exec python3 "${DSM_ROOT}/database/registry.py" \
                --root "${DSM_ROOT}" \
                purge-orphan "$1"
            ;;
        *) usage; return 1 ;;
    esac
}

agent_command()
{
    local RESOURCE="${1:-}"

    case "${RESOURCE}" in
        ports)
            shift
            exec python3 "${DSM_ROOT}/database/agent_ports_cli.py" "$@"
            ;;
        *)
            echo "Uso:" >&2
            echo "  cap agent ports show <agent-id>" >&2
            echo "  cap agent ports set <agent-id> <inicio> <fim> [--protocol tcp|udp|both]" >&2
            echo "  cap agent ports check <agent-id>" >&2
            return 2
            ;;
    esac
}

operations_command()
{
    exec python3 "${DSM_ROOT}/database/operations.py" \
        --root "${DSM_ROOT}" "$@"
}

case "${1:-}" in
    start|stop|restart|status)
        server_command "$@"
        ;;
    server)
        shift
        server_command "$@"
        ;;
    doctor)
        shift
        source "${DSM_ROOT}/doctor/doctor.sh"
        case "${1:-run}" in
            run)
                doctor_run
                ;;
            status)
                if ! declare -F runtime_get >/dev/null
                then
                    echo "Runtime indisponível."
                    exit 1
                fi

                DATA="$(runtime_get doctor)"
                if [[ -z "${DATA}" ]]
                then
                    echo "Nenhum diagnóstico disponível."
                    echo
                    echo "Execute:"
                    echo " cap doctor run"
                    exit 1
                fi

                doctor_format_status "${DATA}"
                ;;
            *)
                echo
                echo "Uso:"
                echo " cap doctor run"
                echo " cap doctor status"
                ;;
        esac
        ;;
    monitor)
        shift
        monitor_command "$@"
        ;;
    mods)
        shift
        mods_dispatch "$@"
        ;;
    backup)
        shift
        backup_command "$@"
        ;;
    user)
        shift
        exec "$DSM_ROOT/core/user_manager.sh" "$@"
        ;;
    runtime)
        shift
        "${DSM_ROOT}/bin/dsm-runtime" "$@"
        ;;
    config)
        shift
        config_command "$@"
        ;;
    steam)
        shift
        steam_command "$@"
        ;;
    game)
        shift
        game_command "$@"
        ;;
    catalog)
        shift
        catalog_command "$@"
        ;;
    content)
        shift
        catalog_command content "$@"
        ;;
    compatibility)
        shift
        catalog_command compatibility "$@"
        ;;
    update)
        shift
        update_command "$@"
        ;;
    database|db)
        shift
        database_command "$@"
        ;;
    agent)
        shift
        agent_command "$@"
        ;;
    instance)
        shift
        instance_command "$@"
        ;;
    operations|ops)
        shift
        operations_command "$@"
        ;;
    *)
        usage
        ;;
esac
