#!/bin/bash
# =============================================================
# bin/dsm - CLI de compatibilidade operacional
# =============================================================

set -Eeuo pipefail

if ! pwd -P >/dev/null 2>&1
then
    cd /opt 2>/dev/null || cd /
fi

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
export DSM_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

BOOTSTRAP="${DSM_ROOT}/core/bootstrap.sh"
if [[ ! -f "${BOOTSTRAP}" ]]
then
    echo "Bootstrap não encontrado:" >&2
    echo "${BOOTSTRAP}" >&2
    exit 1
fi
# shellcheck source=/dev/null
source "${BOOTSTRAP}"

export DSM_DATABASE_DRIVER DSM_DATABASE DSM_DATABASE_HOST DSM_DATABASE_PORT
export DSM_DATABASE_NAME DSM_DATABASE_USER DSM_DATABASE_PASSWORD_FILE DSM_DATABASE_TLS

update_command()
{
    local ACTION="${1:-}"
    local module="${DSM_ROOT}/update-manager/update-manager.sh"
    if [[ ! -f "${module}" ]]
    then
        echo "Update Manager não encontrado:" >&2
        echo "${module}" >&2
        return 1
    fi
    # shellcheck source=/dev/null
    source "${module}"
    case "${ACTION}" in
        check) dsm_update_check ;;
        run) dsm_update_run ;;
        history) dsm_update_history ;;
        *)
            echo "Uso:" >&2
            echo "  dsm update check" >&2
            echo "  dsm update run" >&2
            echo "  dsm update history" >&2
            return 2
            ;;
    esac
}

usage()
{
cat <<'EOF'
Capivara Distributed Server Manager - CLI de compatibilidade

Uso:
  dsm <comando>

Servidor:
  dsm server start <game> <instance>
  dsm server stop <game> <instance>
  dsm server restart <game> <instance>
  dsm server status <game> <instance>
  dsm server validate <game> <instance>

Monitor:
  dsm monitor

Mods:
  dsm mods install
  dsm mods update
  dsm mods verify
  dsm mods rollback
  dsm mods keys
  dsm mods state

Backup:
  dsm backup create
  dsm backup restore <arquivo>
  dsm backup snapshot

Configuração:
  dsm config show

Update:
  dsm update check
  dsm update run
  dsm update history

Steam:
  dsm steam auth

Dashboard:
  dsm user add <usuario> <admin|operator|controller|customer> [scope]
  dsm user remove <usuario>
  dsm user passwd <usuario>
  dsm user list

Games:
  dsm game install <environment-id> <version|latest|current>
  dsm game show <environment-id> <version|latest|current>

Catálogo/Conteúdo:
  dsm catalog ...
  dsm content ...
  dsm compatibility ...

Agents:
  dsm agent ports show <agent-id>
  dsm agent ports set <agent-id> <inicio> <fim> [--protocol tcp|udp|both]
  dsm agent ports check <agent-id>

Database:
  dsm database init
  dsm database migrate
  dsm database status
  dsm database check
  dsm database backup <arquivo.db>
  dsm database restore <arquivo> --confirm-restore

Operação:
  dsm operations readiness

Instâncias:
  dsm instance create-aurora
  dsm instance purge-orphan <id>

O Doctor legado foi removido. Use:
  cap infrastructure doctor [--json]
EOF
}

server_command()
{
    local ACTION="${1:-}"
    local GAME="${2:-}"
    local INSTANCE="${3:-}"

    [[ -n "${GAME}" ]] && export GAME_ID="${GAME}"
    [[ -n "${INSTANCE}" ]] && export DSM_INSTANCE_ID="${INSTANCE}"

    case "${ACTION}" in
        start|stop|restart|status|validate|publish)
            if [[ -z "${GAME_ID:-}" || -z "${DSM_INSTANCE_ID:-}" ]]
            then
                echo "Uso: dsm server ${ACTION} <game> <instance>" >&2
                return 1
            fi
            ;;
        *) usage; return 1 ;;
    esac

    case "${ACTION}" in
        start)
            # shellcheck source=/dev/null
            source "${DSM_ROOT}/server/start.sh"
            server_start
            ;;
        stop)
            # shellcheck source=/dev/null
            source "${DSM_ROOT}/server/stop.sh"
            server_stop
            ;;
        restart)
            # shellcheck source=/dev/null
            source "${DSM_ROOT}/server/restart.sh"
            server_restart
            ;;
        status)
            # shellcheck source=/dev/null
            source "${DSM_ROOT}/server/status.sh"
            server_status
            ;;
        validate)
            # shellcheck source=/dev/null
            source "${DSM_ROOT}/server/validate.sh"
            server_validate
            ;;
        publish)
            # shellcheck source=/dev/null
            source "${DSM_ROOT}/core/runtime/publisher.sh"
            publish_server_state
            ;;
    esac
}

monitor_command()
{
    local module="${DSM_ROOT}/monitor/diagnose.sh"
    if [[ ! -f "${module}" ]]
    then
        echo "Módulo Monitor não encontrado: ${module}" >&2
        return 1
    fi
    # shellcheck source=/dev/null
    source "${module}"
    diagnose_run "$@"
}

mods_dispatch()
{
    local module="${DSM_ROOT}/mods/mods.sh"
    if [[ ! -f "${module}" ]]
    then
        echo "Dispatcher de Mods não encontrado: ${module}" >&2
        return 1
    fi
    bash "${module}" "$@"
}

backup_command()
{
    case "${1:-}" in
        create)
            # shellcheck source=/dev/null
            source "${DSM_ROOT}/backup/create.sh"
            backup_create
            ;;
        restore)
            # shellcheck source=/dev/null
            source "${DSM_ROOT}/backup/restore.sh"
            restore_backup "${2:-}"
            ;;
        snapshot)
            # shellcheck source=/dev/null
            source "${DSM_ROOT}/backup/snapshot.sh"
            snapshot_create
            ;;
        *) usage; return 2 ;;
    esac
}

config_command()
{
    case "${1:-}" in
        show) config_show ;;
        *) usage; return 2 ;;
    esac
}

game_command()
{
    local ACTION="${1:-}"
    shift || true
    case "${ACTION}" in
        install|show)
            exec "${DSM_ROOT}/installer/install_selection.sh" "${ACTION}" "$@"
            ;;
        *)
            echo "Uso: dsm game install|show <environment-id> <version|latest|current>" >&2
            return 2
            ;;
    esac
}

steam_command()
{
    local ACTION="${1:-}"
    local PROVIDER="${DSM_ROOT}/installer/providers/steam.sh"
    local CONF="${DSM_ROOT}/config/providers/steam.conf"

    case "${ACTION}" in
        auth)
            [[ -f "${PROVIDER}" ]] || { echo "Provider Steam não encontrado: ${PROVIDER}" >&2; return 1; }
            if [[ -f "${CONF}" ]]
            then
                unset DSM_STEAM_USER 2>/dev/null || true
                unset STEAM_USER 2>/dev/null || true
                # shellcheck source=/dev/null
                source "${CONF}"
            fi
            local USER="${DSM_STEAM_USER:-${STEAM_USER:-}}"
            if [[ -z "${USER}" ]]
            then
                echo "Usuário Steam não configurado. Configure DSM_STEAM_USER em ${CONF}" >&2
                return 1
            fi
            # shellcheck source=/dev/null
            source "${PROVIDER}"
            steam_provider_authenticate "${USER}"
            ;;
        *) echo "Uso: dsm steam auth" >&2; return 2 ;;
    esac
}

catalog_command()
{
    exec "${DSM_ROOT}/installer/catalog.sh" "$@"
}

database_command()
{
    exec python3 "${DSM_ROOT}/database/manager.py" --root "${DSM_ROOT}" "$@"
}

instance_command()
{
    case "${1:-}" in
        bootstrap|bootstrap-status)
            exec python3 "${DSM_ROOT}/database/registry.py" --root "${DSM_ROOT}" "$@"
            ;;
        create-aurora)
            exec python3 "${DSM_ROOT}/database/registry.py" --root "${DSM_ROOT}" create-aurora
            ;;
        purge-orphan)
            shift
            [[ $# -eq 1 ]] || { echo "Uso: dsm instance purge-orphan <instance-id>" >&2; return 2; }
            exec python3 "${DSM_ROOT}/database/registry.py" --root "${DSM_ROOT}" purge-orphan "$1"
            ;;
        *) usage; return 1 ;;
    esac
}

agent_command()
{
    local RESOURCE="${1:-}"
    case "${RESOURCE}" in
        ports)
            shift
            exec python3 "${DSM_ROOT}/database/agent_ports_cli.py" "$@"
            ;;
        *)
            echo "Uso:" >&2
            echo "  dsm agent ports show <agent-id>" >&2
            echo "  dsm agent ports set <agent-id> <inicio> <fim> [--protocol tcp|udp|both]" >&2
            echo "  dsm agent ports check <agent-id>" >&2
            return 2
            ;;
    esac
}

operations_command()
{
    exec python3 "${DSM_ROOT}/database/operations.py" --root "${DSM_ROOT}" "$@"
}

case "${1:-}" in
    start|stop|restart|status)
        server_command "$@"
        ;;
    server)
        shift
        server_command "$@"
        ;;
    monitor)
        shift
        monitor_command "$@"
        ;;
    mods)
        shift
        mods_dispatch "$@"
        ;;
    backup)
        shift
        backup_command "$@"
        ;;
    user)
        shift
        exec "${DSM_ROOT}/core/user_manager.sh" "$@"
        ;;
    runtime)
        shift
        exec "${DSM_ROOT}/bin/dsm-runtime" "$@"
        ;;
    config)
        shift
        config_command "$@"
        ;;
    steam)
        shift
        steam_command "$@"
        ;;
    game)
        shift
        game_command "$@"
        ;;
    catalog)
        shift
        catalog_command "$@"
        ;;
    content)
        shift
        catalog_command content "$@"
        ;;
    compatibility)
        shift
        catalog_command compatibility "$@"
        ;;
    update)
        shift
        update_command "$@"
        ;;
    database|db)
        shift
        database_command "$@"
        ;;
    agent)
        shift
        agent_command "$@"
        ;;
    instance)
        shift
        instance_command "$@"
        ;;
    operations|ops)
        shift
        operations_command "$@"
        ;;
    doctor)
        echo "O Doctor legado foi removido. Use: cap infrastructure doctor" >&2
        exit 2
        ;;
    help|--help|-h|"")
        usage
        ;;
    *)
        usage
        exit 2
        ;;
esac
