#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
export DSM_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

BOOTSTRAP="${DSM_ROOT}/core/bootstrap.sh"
if [[ ! -f "${BOOTSTRAP}" ]]; then
    echo "Bootstrap não encontrado: ${BOOTSTRAP}" >&2
    exit 1
fi
# shellcheck source=/dev/null
source "${BOOTSTRAP}"
export DSM_DATABASE_DRIVER DSM_DATABASE DSM_DATABASE_HOST DSM_DATABASE_PORT
export DSM_DATABASE_NAME DSM_DATABASE_USER DSM_DATABASE_PASSWORD_FILE DSM_DATABASE_TLS

usage(){
    cat >&2 <<'EOF'
Uso:
  cap infrastructure doctor [--reconcile] [--json]
  cap infrastructure role show [--node-id ID] [--json]
  cap infrastructure role set hybrid [--node-id ID] [--controller-id ID] [--agent-id ID] [--json]

--reconcile aplica somente reconciliações determinísticas e seguras.

A transição controller -> hybrid preserva o Node e o Controller existentes.
A etapa de role altera apenas identidade/topologia persistida; configuração local,
heartbeat e runtime do Agent são reconciliados em etapa separada.
EOF
}

case "${1:-}" in
    infrastructure)
        shift
        case "${1:-}" in
            doctor)
                shift
                exec python3 "${DSM_ROOT}/database/infrastructure_doctor.py" doctor "$@"
                ;;
            role)
                shift
                [[ $# -gt 0 ]] || { usage; exit 2; }
                exec python3 "${DSM_ROOT}/database/infrastructure_role_cli.py" "$@"
                ;;
            *) usage; exit 2 ;;
        esac
        ;;
    *) usage; exit 2 ;;
esac
