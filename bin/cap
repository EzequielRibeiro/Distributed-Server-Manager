#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
export DSM_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

BOOTSTRAP="${DSM_ROOT}/core/bootstrap.sh"
if [[ ! -f "${BOOTSTRAP}" ]]; then
    echo "Bootstrap não encontrado: ${BOOTSTRAP}" >&2
    exit 1
fi
# shellcheck source=/dev/null
source "${BOOTSTRAP}"
export DSM_DATABASE_DRIVER DSM_DATABASE DSM_DATABASE_HOST DSM_DATABASE_PORT
export DSM_DATABASE_NAME DSM_DATABASE_USER DSM_DATABASE_PASSWORD_FILE DSM_DATABASE_TLS

LEGACY_DSM="${DSM_ROOT}/bin/dsm"
AGENT_LOCAL_CLI="${DSM_ROOT}/agents/linux/runtime/local_cli.py"
ROLE_RESOLVER="${DSM_ROOT}/core/role_context.py"
CAP_ROLE_CACHE=""

local_role(){
    if [[ -n "${CAP_ROLE_CACHE}" ]]; then
        printf '%s\n' "${CAP_ROLE_CACHE}"
        return 0
    fi
    if [[ ! -f "${ROLE_RESOLVER}" ]]; then
        CAP_ROLE_CACHE="unknown"
    else
        CAP_ROLE_CACHE="$(python3 "${ROLE_RESOLVER}" --root "${DSM_ROOT}" 2>/dev/null || true)"
        CAP_ROLE_CACHE="${CAP_ROLE_CACHE:-unknown}"
    fi
    printf '%s\n' "${CAP_ROLE_CACHE}"
}

require_role(){
    local command_label="$1"
    shift
    local role
    local allowed
    local allowed_text=""
    role="$(local_role)"
    for allowed in "$@"; do
        if [[ "${role}" == "${allowed}" ]]; then
            return 0
        fi
        if [[ -z "${allowed_text}" ]]; then
            allowed_text="${allowed}"
        else
            allowed_text+=" ou ${allowed}"
        fi
    done
    printf "Erro: '%s' requer role %s.\n" "${command_label}" "${allowed_text}" >&2
    printf 'Role local detectada: %s.\n' "${role}" >&2
    if [[ "${role}" == "unknown" ]]; then
        printf 'Defina DSM_NODE_ROLE=controller|agent|hybrid em config/agent.conf ou config/dsm.conf.\n' >&2
    fi
    exit 2
}

usage(){
    local role="${1:-unknown}"
    local show_all="${2:-0}"
    cat >&2 <<EOF
Capivara Distributed Server Manager

Uso:
  cap <comando> [opções]

Role local: ${role}
EOF

    if [[ "${show_all}" == "1" || "${role}" == "controller" || "${role}" == "hybrid" ]]; then
        cat >&2 <<'EOF'

Controller / Hybrid:
  cap infrastructure doctor [--reconcile] [--json]
  cap infrastructure role show [--node-id ID] [--json]
  cap infrastructure role set hybrid [--node-id ID] [--controller-id ID] [--agent-id ID] [--json]
  cap agent deploy HOST --ssh-user USER [options]
  cap agent ports show <agent-id>
  cap agent ports set <agent-id> <inicio> <fim> [--protocol tcp|udp|both]
  cap agent ports check <agent-id>
  cap user ...
  cap catalog ...
  cap database|db ...
  cap instance <comandos administrativos> ...
  cap operations|ops ...
EOF
    fi

    if [[ "${show_all}" == "1" || "${role}" == "agent" || "${role}" == "hybrid" ]]; then
        cat >&2 <<'EOF'

Agent local / Hybrid:
  cap agent status [--json]
  cap agent info [--json]
  cap agent health [--json]
  cap agent heartbeat [--json]
  cap agent capabilities [--json]
  cap agent network [--json]
  cap agent ports show [--json]
  cap agent ports check [--json]
  cap agent game-data list [--json]
  cap agent game-data status <game> [--json]
  cap agent jobs [--active] [--limit N] [--json]
  cap agent jobs show <job-id> [--json]
  cap agent update status [--json]
  cap agent update history [--limit N] [--json]
  cap agent update check [--channel stable|beta] [--json]
  cap agent logs [--lines N] [--json]
  cap agent doctor [--json]
  cap instance list [--json]
  cap instance status <instance> [--json]
  cap instance doctor <instance> [--json]
  cap server|monitor|mods|backup|runtime|steam|game|content|compatibility ...
  cap start|stop|restart|status ...
EOF
    fi

    cat >&2 <<'EOF'

Todas as roles conhecidas:
  cap config ...
  cap update ...
  cap help --all        mostra a referência completa

O enforcement de role ocorre antes do dispatch administrativo. O resolver é
observacional: não inicializa database, não executa migrations e não atualiza
health/placement. Em instalação legado SQLite, a role pode ser lida em modo
estritamente read-only apenas para compatibilidade.
EOF
}

legacy_exec(){
    if [[ ! -x "${LEGACY_DSM}" ]]; then
        echo "CLI de compatibilidade não encontrada ou não executável: ${LEGACY_DSM}" >&2
        exit 1
    fi
    exec "${LEGACY_DSM}" "$@"
}

agent_local_exec(){
    if [[ ! -f "${AGENT_LOCAL_CLI}" ]]; then
        echo "CLI local do Agent Linux não encontrada: ${AGENT_LOCAL_CLI}" >&2
        exit 1
    fi
    exec python3 "${AGENT_LOCAL_CLI}" "$@"
}

case "${1:-}" in
    help|--help|-h|"")
        role="$(local_role)"
        if [[ "${2:-}" == "--all" ]]; then
            usage "${role}" 1
        else
            usage "${role}" 0
        fi
        ;;

    infrastructure)
        require_role "cap infrastructure" controller hybrid
        shift
        case "${1:-}" in
            doctor)
                shift
                exec python3 "${DSM_ROOT}/database/infrastructure_doctor_contract.py" doctor "$@"
                ;;
            role)
                shift
                [[ $# -gt 0 ]] || { usage "$(local_role)" 0; exit 2; }
                exec python3 "${DSM_ROOT}/database/infrastructure_role_cli.py" "$@"
                ;;
            *) usage "$(local_role)" 0; exit 2 ;;
        esac
        ;;

    agent)
        shift
        case "${1:-}" in
            deploy)
                require_role "cap agent deploy" controller hybrid
                shift
                exec python3 "${DSM_ROOT}/database/agent_deploy_cli.py" "$@"
                ;;
            ports)
                case "${2:-}" in
                    show|check)
                        if [[ $# -eq 2 || "${3:-}" == --* ]]; then
                            require_role "cap agent ports ${2}" agent hybrid
                            agent_local_exec "$@"
                        else
                            require_role "cap agent ports ${2} <agent-id>" controller hybrid
                            legacy_exec agent "$@"
                        fi
                        ;;
                    set)
                        require_role "cap agent ports set" controller hybrid
                        legacy_exec agent "$@"
                        ;;
                    *) usage "$(local_role)" 0; exit 2 ;;
                esac
                ;;
            status|info|health|heartbeat|capabilities|network|game-data|jobs|update|logs|doctor)
                require_role "cap agent ${1}" agent hybrid
                agent_local_exec "$@"
                ;;
            *) usage "$(local_role)" 0; exit 2 ;;
        esac
        ;;

    instance)
        case "${2:-}" in
            list|status|doctor)
                require_role "cap instance ${2}" agent hybrid
                agent_local_exec "$@"
                ;;
            *)
                require_role "cap instance" controller hybrid
                legacy_exec "$@"
                ;;
        esac
        ;;

    user|catalog|database|db|operations|ops)
        require_role "cap ${1}" controller hybrid
        legacy_exec "$@"
        ;;

    start|stop|restart|status|server|monitor|mods|backup|runtime|steam|game|content|compatibility)
        require_role "cap ${1}" agent hybrid
        legacy_exec "$@"
        ;;

    config|update)
        require_role "cap ${1}" controller agent hybrid
        legacy_exec "$@"
        ;;

    *)
        usage "$(local_role)" 0
        exit 2
        ;;
esac
