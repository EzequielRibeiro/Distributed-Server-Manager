#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
export DSM_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

BOOTSTRAP="${DSM_ROOT}/core/bootstrap.sh"
if [[ ! -f "${BOOTSTRAP}" ]]; then
    echo "Bootstrap não encontrado: ${BOOTSTRAP}" >&2
    exit 1
fi
# shellcheck source=/dev/null
source "${BOOTSTRAP}"
export DSM_DATABASE_DRIVER DSM_DATABASE DSM_DATABASE_HOST DSM_DATABASE_PORT
export DSM_DATABASE_NAME DSM_DATABASE_USER DSM_DATABASE_PASSWORD_FILE DSM_DATABASE_TLS

LEGACY_DSM="${DSM_ROOT}/bin/dsm"
AGENT_LOCAL_CLI="${DSM_ROOT}/agents/linux/runtime/local_cli.py"

usage(){
    cat >&2 <<'EOF'
Capivara Distributed Server Manager

Uso:
  cap <comando> [opções]

Infraestrutura:
  cap infrastructure doctor [--reconcile] [--json]
  cap infrastructure role show [--node-id ID] [--json]
  cap infrastructure role set hybrid [--node-id ID] [--controller-id ID] [--agent-id ID] [--json]

Agents — Controller/Hybrid:
  cap agent deploy HOST --ssh-user USER [options]
  cap agent ports show <agent-id>
  cap agent ports set <agent-id> <inicio> <fim> [--protocol tcp|udp|both]
  cap agent ports check <agent-id>

Agent local — Linux:
  cap agent status [--json]
  cap agent info [--json]
  cap agent health [--json]
  cap agent heartbeat [--json]
  cap agent capabilities [--json]
  cap agent network [--json]
  cap agent logs [--lines N] [--json]
  cap agent doctor [--json]

Comandos operacionais disponíveis via camada de compatibilidade:
  cap server ...
  cap monitor ...
  cap mods ...
  cap backup ...
  cap user ...
  cap runtime ...
  cap config ...
  cap steam ...
  cap game ...
  cap catalog ...
  cap content ...
  cap compatibility ...
  cap update ...
  cap database ...
  cap db ...
  cap instance ...
  cap operations ...
  cap ops ...

Compatibilidade curta também preservada:
  cap start|stop|restart|status ...

`cap infrastructure doctor` é o Doctor da infraestrutura distribuída.
`cap agent doctor` é o Doctor local do Agent Linux e não consulta a database do Controller.
`cap` é a CLI oficial em consolidação. Nesta fase, os demais comandos operacionais
legados são encaminhados internamente para `dsm` sem duplicação de lógica.
EOF
}

legacy_exec(){
    if [[ ! -x "${LEGACY_DSM}" ]]; then
        echo "CLI de compatibilidade não encontrada ou não executável: ${LEGACY_DSM}" >&2
        exit 1
    fi
    exec "${LEGACY_DSM}" "$@"
}

agent_local_exec(){
    if [[ ! -f "${AGENT_LOCAL_CLI}" ]]; then
        echo "CLI local do Agent Linux não encontrada: ${AGENT_LOCAL_CLI}" >&2
        exit 1
    fi
    exec python3 "${AGENT_LOCAL_CLI}" "$@"
}

case "${1:-}" in
    help|--help|-h|"")
        usage
        ;;

    infrastructure)
        shift
        case "${1:-}" in
            doctor)
                shift
                exec python3 "${DSM_ROOT}/database/infrastructure_doctor_contract.py" doctor "$@"
                ;;
            role)
                shift
                [[ $# -gt 0 ]] || { usage; exit 2; }
                exec python3 "${DSM_ROOT}/database/infrastructure_role_cli.py" "$@"
                ;;
            *) usage; exit 2 ;;
        esac
        ;;

    agent)
        shift
        case "${1:-}" in
            deploy)
                shift
                exec python3 "${DSM_ROOT}/database/agent_deploy_cli.py" "$@"
                ;;
            ports)
                legacy_exec agent "$@"
                ;;
            status|info|health|heartbeat|capabilities|network|logs|doctor)
                agent_local_exec "$@"
                ;;
            *) usage; exit 2 ;;
        esac
        ;;

    start|stop|restart|status|server|monitor|mods|backup|user|runtime|config|steam|game|catalog|content|compatibility|update|database|db|instance|operations|ops)
        legacy_exec "$@"
        ;;

    *)
        usage
        exit 2
        ;;
esac
