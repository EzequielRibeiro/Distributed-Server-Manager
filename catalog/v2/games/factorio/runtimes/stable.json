{
  "schema_version": 2,
  "kind": "RuntimeDefinition",
  "id": "factorio.stable",
  "name": "Factorio Headless Server",
  "game": "factorio",
  "edition": "headless",
  "variant": "stable",
  "loader": null,
  "version": {
    "strategy": "static",
    "value": "stable",
    "build": "headless-linux64"
  },
  "process": {
    "engine": "native",
    "executable": "factorio/bin/x64/factorio",
    "artifact_mode": "executable"
  },
  "requirements": {
    "os": [
      "linux"
    ],
    "architectures": [
      "x86_64"
    ],
    "java": null
  },
  "artifact": {
    "provider": "http-archive",
    "auth": "anonymous",
    "url": "https://www.factorio.com/get-download/stable/headless/linux64",
    "archive_type": "tar.xz"
  },
  "installation": {
    "directory": "/opt/dsm/game-data/factorio/serverfiles"
  },
  "network": {
    "allocation": "block",
    "block_size": 1,
    "ports": [
      {
        "name": "game",
        "protocol": "udp",
        "offset": 0,
        "exposure": "public"
      }
    ]
  },
  "server_settings": {
    "restart_required": true,
    "fields": {
      "server_name": {
        "label": "Nome do servidor",
        "type": "string",
        "customer_editable": true,
        "binding": {
          "kind": "json",
          "path": "server-settings.json",
          "keys": [
            "name"
          ]
        },
        "max_length": 128
      },
      "description": {
        "label": "Descrição",
        "type": "string",
        "customer_editable": true,
        "binding": {
          "kind": "json",
          "path": "server-settings.json",
          "keys": [
            "description"
          ]
        },
        "max_length": 512
      },
      "max_players": {
        "label": "Máximo de jogadores",
        "type": "integer",
        "customer_editable": true,
        "binding": {
          "kind": "json",
          "path": "server-settings.json",
          "keys": [
            "max_players"
          ]
        },
        "min": 0,
        "max": 1000
      },
      "public": {
        "label": "Servidor público",
        "type": "boolean",
        "customer_editable": true,
        "binding": {
          "kind": "json",
          "path": "server-settings.json",
          "keys": [
            "visibility",
            "public"
          ]
        }
      }
    }
  }
}
