{
  "schema_version": 2,
  "kind": "RuntimeDefinition",
  "id": "rust.stable",
  "name": "Rust Dedicated Server",
  "game": "rust",
  "edition": "default",
  "variant": "stable",
  "loader": null,
  "version": {
    "strategy": "static",
    "value": "current",
    "build": "steam-current"
  },
  "process": {
    "engine": "native",
    "executable": "RustDedicated",
    "artifact_mode": "executable"
  },
  "requirements": {
    "os": [
      "linux",
      "windows"
    ],
    "architectures": [
      "x86_64"
    ],
    "java": null
  },
  "artifact": {
    "provider": "steam",
    "auth": "anonymous",
    "package_id": "258550"
  },
  "installation": {
    "directory": "/opt/dsm/game-data/rust/serverfiles"
  },
  "network": {
    "allocation": "block",
    "block_size": 10,
    "ports": [
      {
        "name": "game",
        "protocol": "udp",
        "offset": 0
      },
      {
        "name": "rcon",
        "protocol": "tcp",
        "offset": 1
      },
      {
        "name": "query",
        "protocol": "udp",
        "offset": 2
      }
    ],
    "apply": [
      {
        "kind": "argument",
        "template": "+server.port {game}"
      },
      {
        "kind": "argument",
        "template": "+rcon.port {rcon}"
      },
      {
        "kind": "argument",
        "template": "+server.queryport {query}"
      }
    ]
  }
}
