{
  "schema_version": 2,
  "kind": "RuntimeDefinition",
  "id": "dayz.stable",
  "name": "DayZ Dedicated Server",
  "game": "dayz",
  "edition": "default",
  "variant": "stable",
  "loader": null,
  "version": {
    "strategy": "static",
    "value": "current",
    "build": "steam-current"
  },
  "process": {
    "engine": "native",
    "executable": "DayZServer",
    "artifact_mode": "executable",
    "args": [
      "-config=serverDZ.cfg"
    ]
  },
  "requirements": {
    "os": [
      "linux",
      "windows"
    ],
    "architectures": [
      "x86_64"
    ],
    "java": null
  },
  "artifact": {
    "provider": "steam",
    "auth": "required",
    "package_id": "223350"
  },
  "installation": {
    "directory": "/opt/dsm/game-data/dayz/serverfiles"
  },
  "network": {
    "allocation": "block",
    "block_size": 10,
    "ports": [
      {
        "name": "game",
        "protocol": "udp",
        "offset": 0
      },
      {
        "name": "game_aux",
        "protocol": "udp",
        "offset": 2
      },
      {
        "name": "steam_query",
        "protocol": "udp",
        "offset": 3
      }
    ],
    "apply": [
      {
        "kind": "argument",
        "template": "-port={game}"
      },
      {
        "kind": "derived",
        "port": "game_aux",
        "from": "game"
      },
      {
        "kind": "property",
        "file": "serverDZ.cfg",
        "key": "steamQueryPort",
        "value": "{steam_query}",
        "syntax": "semicolon"
      }
    ]
  },
  "configuration": {
    "files": [
      {
        "id": "server",
        "path": "serverDZ.cfg",
        "category": "game",
        "label": "Configuração do servidor",
        "editable": false,
        "optional": false,
        "format": "semicolon_properties",
        "properties": [
          {
            "key": "hostname",
            "source": "CUSTOMER",
            "type": "string"
          },
          {
            "key": "description",
            "source": "CUSTOMER",
            "type": "string"
          },
          {
            "key": "enableWhitelist",
            "source": "CUSTOMER",
            "type": "boolean"
          },
          {
            "key": "disable3rdPerson",
            "source": "CUSTOMER",
            "type": "boolean"
          },
          {
            "key": "disableCrosshair",
            "source": "CUSTOMER",
            "type": "boolean"
          },
          {
            "key": "disableVoN",
            "source": "CUSTOMER",
            "type": "boolean"
          },
          {
            "key": "vonCodecQuality",
            "source": "CUSTOMER",
            "type": "integer"
          },
          {
            "key": "motdInterval",
            "source": "CUSTOMER",
            "type": "integer"
          },
          {
            "key": "serverTime",
            "source": "CUSTOMER",
            "type": "string"
          },
          {
            "key": "serverTimeAcceleration",
            "source": "CUSTOMER",
            "type": "integer"
          },
          {
            "key": "serverNightTimeAcceleration",
            "source": "CUSTOMER",
            "type": "integer"
          },
          {
            "key": "serverTimePersistent",
            "source": "CUSTOMER",
            "type": "boolean"
          },
          {
            "key": "maxPlayers",
            "source": "CONTRACT",
            "type": "integer"
          },
          {
            "key": "steamQueryPort",
            "source": "SYSTEM",
            "type": "integer"
          }
        ]
      }
    ]
  }
}
