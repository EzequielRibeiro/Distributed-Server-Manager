{
  "schema_version": 2,
  "kind": "RuntimeDefinition",
  "id": "dayz.stable",
  "name": "DayZ Dedicated Server",
  "game": "dayz",
  "edition": "default",
  "variant": "stable",
  "loader": null,
  "version": {
    "strategy": "static",
    "value": "current",
    "build": "steam-current"
  },
  "process": {
    "engine": "native",
    "executable": "DayZServer",
    "artifact_mode": "executable",
    "args": [
      "-config=serverDZ.cfg"
    ]
  },
  "requirements": {
    "os": [
      "linux",
      "windows"
    ],
    "architectures": [
      "x86_64"
    ],
    "java": null
  },
  "artifact": {
    "provider": "steam",
    "auth": "required",
    "package_id": "223350"
  },
  "content": {
    "steam_workshop": {
      "app_id": "221100"
    }
  },
  "installation": {
    "directory": "/opt/dsm/game-data/dayz/serverfiles"
  },
  "network": {
    "allocation": "block",
    "block_size": 10,
    "ports": [
      {
        "name": "game",
        "protocol": "udp",
        "offset": 0,
        "exposure": "public"
      },
      {
        "name": "game_aux",
        "protocol": "udp",
        "offset": 2,
        "exposure": "public"
      },
      {
        "name": "steam_query",
        "protocol": "udp",
        "offset": 3,
        "exposure": "public"
      }
    ],
    "apply": [
      {
        "kind": "argument",
        "template": "-port={game}"
      },
      {
        "kind": "derived",
        "port": "game_aux",
        "from": "game"
      },
      {
        "kind": "property",
        "file": "serverDZ.cfg",
        "key": "steamQueryPort",
        "value": "{steam_query}",
        "syntax": "semicolon"
      }
    ]
  },
  "server_settings": {
    "restart_required": true,
    "fields": {
      "server_name": {
        "label": "Nome do servidor",
        "type": "string",
        "customer_editable": true,
        "binding": {
          "kind": "property",
          "path": "serverDZ.cfg",
          "key": "hostname",
          "syntax": "semicolon",
          "quote": "double"
        },
        "max_length": 128,
        "description": "Nome exibido aos jogadores."
      },
      "max_players": {
        "label": "Máximo de jogadores",
        "type": "integer",
        "customer_editable": true,
        "binding": {
          "kind": "property",
          "path": "serverDZ.cfg",
          "key": "maxPlayers",
          "syntax": "semicolon"
        },
        "min": 1,
        "max": 200,
        "description": "Limitado também pelo plano contratado."
      }
    }
  }
}
