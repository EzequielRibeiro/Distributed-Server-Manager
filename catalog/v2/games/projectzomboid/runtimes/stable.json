{
  "schema_version": 2,
  "kind": "RuntimeDefinition",
  "id": "projectzomboid.stable",
  "name": "Project Zomboid Dedicated Server",
  "game": "projectzomboid",
  "edition": "default",
  "variant": "stable",
  "loader": null,
  "version": {
    "strategy": "static",
    "value": "current",
    "build": "steam-current"
  },
  "process": {
    "engine": "native",
    "executable": "start-server.sh",
    "artifact_mode": "executable",
    "args": ["-servername", "servertest"]
  },
  "requirements": {
    "os": ["linux"],
    "architectures": ["x86_64"],
    "java": null
  },
  "artifact": {
    "provider": "steam",
    "auth": "anonymous",
    "package_id": "380870"
  },
  "installation": {
    "directory": "/opt/dsm/game-data/projectzomboid/serverfiles"
  },
  "network": {
    "allocation": "block",
    "block_size": 10,
    "ports": [
      {"name": "game", "protocol": "udp", "offset": 0}
    ],
    "apply": [
      {"kind": "argument", "template": "-port {game}"}
    ]
  }
}
