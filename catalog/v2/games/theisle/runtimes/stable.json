{
  "schema_version": 2,
  "kind": "RuntimeDefinition",
  "id": "theisle.stable",
  "name": "The Isle Evrima Dedicated Server",
  "game": "theisle",
  "edition": "evrima",
  "variant": "stable",
  "loader": null,
  "version": {
    "strategy": "static",
    "value": "evrima",
    "build": "steam-evrima",
    "config": {
      "steam_branch": "evrima"
    }
  },
  "process": {
    "engine": "native",
    "executable": "TheIsle/Binaries/Linux/TheIsleServer-Linux-Shipping",
    "artifact_mode": "executable"
  },
  "requirements": {
    "os": [
      "linux"
    ],
    "architectures": [
      "x86_64"
    ],
    "java": null
  },
  "artifact": {
    "provider": "steam",
    "auth": "anonymous",
    "package_id": "412680",
    "branch": "evrima"
  },
  "installation": {
    "directory": "/opt/dsm/game-data/theisle/serverfiles"
  },
  "network": {
    "allocation": "block",
    "block_size": 2,
    "ports": [
      {
        "name": "game",
        "protocol": "udp",
        "offset": 0,
        "exposure": "public"
      },
      {
        "name": "steam_query",
        "protocol": "udp",
        "offset": 1,
        "exposure": "public"
      }
    ]
  },
  "runtime_secrets": [
    {
      "name": "EOS_CLIENT_ID",
      "required": true,
      "target": "file"
    },
    {
      "name": "EOS_CLIENT_SECRET",
      "required": true,
      "target": "file"
    }
  ],
  "runtime_profile": "theisle",
  "server_settings": {
    "restart_required": true,
    "fields": {
      "server_name": {
        "label": "Nome do servidor",
        "type": "string",
        "customer_editable": true,
        "max_length": 128,
        "binding": {
          "kind": "ini",
          "path": "Game.ini",
          "section": "/Script/TheIsle.TIGameSession",
          "key": "ServerName",
          "quote": "double"
        }
      },
      "max_players": {
        "label": "Máximo de jogadores",
        "description": "Também limitado pelo plano contratado.",
        "type": "integer",
        "customer_editable": true,
        "min": 1,
        "max": 200,
        "binding": {
          "kind": "ini",
          "path": "Game.ini",
          "section": "/Script/TheIsle.TIGameSession",
          "key": "MaxPlayerCount"
        }
      },
      "enable_humans": {
        "label": "Permitir humanos",
        "type": "boolean",
        "customer_editable": true,
        "binding": {
          "kind": "ini",
          "path": "Game.ini",
          "section": "/Script/TheIsle.TIGameSession",
          "key": "bEnableHumans",
          "boolean_values": {
            "true": "True",
            "false": "False"
          }
        }
      },
      "global_chat": {
        "label": "Chat global",
        "type": "boolean",
        "customer_editable": true,
        "binding": {
          "kind": "ini",
          "path": "Game.ini",
          "section": "/Script/TheIsle.TIGameSession",
          "key": "bEnableGlobalChat",
          "boolean_values": {
            "true": "True",
            "false": "False"
          }
        }
      }
    }
  }
}
