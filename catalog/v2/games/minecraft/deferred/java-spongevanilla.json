{
  "schema_version": 2,
  "kind": "RuntimeDefinition",
  "id": "minecraft.java.spongevanilla",
  "name": "Minecraft Java SpongeVanilla",
  "game": "minecraft",
  "edition": "java",
  "variant": "spongevanilla",
  "loader": "sponge",
  "version": {
    "strategy": "dynamic",
    "resolver": "sponge_maven"
  },
  "process": {
    "engine": "java",
    "executable": "server.jar",
    "artifact_mode": "file",
    "args": ["nogui"]
  },
  "requirements": {
    "os": ["linux", "windows"],
    "architectures": ["x86_64", "aarch64"],
    "java": {"min": 17, "max": 25}
  },
  "artifact": {
    "provider": "http",
    "auth": "anonymous"
  },
  "installation": {
    "directory": "/opt/dsm/game-data/minecraft/spongevanilla"
  }
}
