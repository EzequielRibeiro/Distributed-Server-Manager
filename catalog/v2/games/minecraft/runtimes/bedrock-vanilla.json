{
  "schema_version": 2,
  "kind": "RuntimeDefinition",
  "id": "minecraft.bedrock.vanilla",
  "name": "Minecraft Bedrock Dedicated Server",
  "game": "minecraft",
  "edition": "bedrock",
  "variant": "bedrock",
  "loader": null,
  "version": {
    "strategy": "dynamic",
    "resolver": "minecraft_bedrock",
    "config": {
      "download_page": "https://www.minecraft.net/en-us/download/server/bedrock",
      "linux_base": "https://www.minecraft.net/bedrockdedicatedserver/bin-linux"
    }
  },
  "process": {
    "engine": "native",
    "executable": "bedrock_server",
    "artifact_mode": "executable"
  },
  "requirements": {
    "os": [
      "linux"
    ],
    "architectures": [
      "x86_64"
    ],
    "java": null
  },
  "artifact": {
    "provider": "http-archive",
    "auth": "anonymous",
    "archive_type": "zip"
  },
  "installation": {
    "directory": "/opt/dsm/game-data/minecraft/bedrock"
  },
  "network": {
    "allocation": "block",
    "block_size": 2,
    "ports": [
      {
        "name": "game_ipv4",
        "protocol": "udp",
        "offset": 0,
        "exposure": "public"
      },
      {
        "name": "game_ipv6",
        "protocol": "udp",
        "offset": 1,
        "exposure": "public"
      }
    ],
    "apply": [
      {
        "kind": "property",
        "file": "server.properties",
        "key": "server-port",
        "value": "{game_ipv4}"
      },
      {
        "kind": "property",
        "file": "server.properties",
        "key": "server-portv6",
        "value": "{game_ipv6}"
      }
    ]
  },
  "server_settings": {
    "restart_required": true,
    "fields": {
      "server_name": {
        "label": "Nome do servidor",
        "type": "string",
        "customer_editable": true,
        "binding": {
          "kind": "property",
          "path": "server.properties",
          "key": "server-name",
          "syntax": "equals"
        },
        "max_length": 64
      },
      "max_players": {
        "label": "Máximo de jogadores",
        "type": "integer",
        "customer_editable": true,
        "binding": {
          "kind": "property",
          "path": "server.properties",
          "key": "max-players",
          "syntax": "equals"
        },
        "min": 1,
        "max": 1000
      },
      "online_mode": {
        "label": "Online mode",
        "type": "boolean",
        "customer_editable": true,
        "binding": {
          "kind": "property",
          "path": "server.properties",
          "key": "online-mode",
          "syntax": "equals"
        }
      },
      "gamemode": {
        "label": "Modo de jogo",
        "type": "select",
        "customer_editable": true,
        "binding": {
          "kind": "property",
          "path": "server.properties",
          "key": "gamemode",
          "syntax": "equals"
        },
        "allowed": [
          "survival",
          "creative",
          "adventure"
        ]
      },
      "difficulty": {
        "label": "Dificuldade",
        "type": "select",
        "customer_editable": true,
        "binding": {
          "kind": "property",
          "path": "server.properties",
          "key": "difficulty",
          "syntax": "equals"
        },
        "allowed": [
          "peaceful",
          "easy",
          "normal",
          "hard"
        ]
      },
      "allow_cheats": {
        "label": "Permitir cheats",
        "type": "boolean",
        "customer_editable": true,
        "binding": {
          "kind": "property",
          "path": "server.properties",
          "key": "allow-cheats",
          "syntax": "equals"
        }
      },
      "view_distance": {
        "label": "Distância de visão",
        "type": "integer",
        "customer_editable": true,
        "binding": {
          "kind": "property",
          "path": "server.properties",
          "key": "view-distance",
          "syntax": "equals"
        },
        "min": 5,
        "max": 96
      }
    }
  }
}
