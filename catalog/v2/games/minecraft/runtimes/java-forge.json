{
  "schema_version": 2,
  "kind": "RuntimeDefinition",
  "id": "minecraft.java.forge",
  "name": "Minecraft Java Forge",
  "game": "minecraft",
  "edition": "java",
  "variant": "forge",
  "loader": "forge",
  "version": {
    "strategy": "dynamic",
    "resolver": "forge_maven"
  },
  "process": {
    "engine": "java",
    "executable": "@java",
    "artifact_mode": "directory",
    "args": [
      "@user_jvm_args.txt",
      "@capivara-launch.args",
      "nogui"
    ]
  },
  "requirements": {
    "os": ["linux", "windows"],
    "architectures": ["x86_64", "aarch64"],
    "java": {"min": 17, "max": 25}
  },
  "artifact": {
    "provider": "http",
    "auth": "anonymous"
  },
  "installation": {
    "directory": "/opt/dsm/game-data/minecraft/forge",
    "installer": {
      "type": "java_jar",
      "args": ["--installServer"],
      "timeout_seconds": 1200,
      "launch_args": {
        "linux_glob": "libraries/net/minecraftforge/forge/*/unix_args.txt",
        "windows_glob": "libraries/net/minecraftforge/forge/*/win_args.txt",
        "output": "capivara-launch.args"
      },
      "expected_outputs": [
        "libraries",
        "user_jvm_args.txt",
        "capivara-launch.args"
      ]
    }
  }
}
