{
  "schema_version": 2,
  "kind": "RuntimeDefinition",
  "id": "minecraft.java.forge",
  "name": "Minecraft Java Forge",
  "game": "minecraft",
  "edition": "java",
  "variant": "forge",
  "loader": "forge",
  "version": {
    "strategy": "dynamic",
    "resolver": "forge_maven",
    "config": {
      "metadata_base": "https://files.minecraftforge.net/net/minecraftforge/forge/"
    }
  },
  "process": {
    "engine": "java",
    "executable": "forge-server.jar",
    "artifact_mode": "file"
  },
  "requirements": {
    "os": ["linux", "windows"],
    "architectures": ["x86_64", "aarch64"],
    "java": {"min": 17, "max": 25}
  },
  "artifact": {
    "provider": "http",
    "auth": "anonymous"
  },
  "installation": {
    "directory": "/opt/dsm/game-data/minecraft/forge"
  }
}
