{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capivara-dsm.local/schemas/v2/runtime-definition.schema.json",
  "title": "RuntimeDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "game", "edition", "variant", "version", "process", "requirements", "artifact", "installation"],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "RuntimeDefinition"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "name": {"type": "string", "minLength": 1},
    "game": {"type": "string", "minLength": 1},
    "edition": {"type": "string", "minLength": 1},
    "variant": {"type": "string", "minLength": 1},
    "loader": {"type": ["string", "null"]},
    "version": {
      "type": "object",
      "required": ["strategy"],
      "properties": {
        "strategy": {"enum": ["static", "dynamic"]},
        "resolver": {"type": ["string", "null"]},
        "value": {"type": ["string", "null"]},
        "build": {"type": ["string", "null"]},
        "config": {"type": "object"}
      }
    },
    "process": {
      "type": "object",
      "required": ["engine", "executable"],
      "properties": {
        "engine": {"enum": ["java", "native"]},
        "executable": {"type": "string", "minLength": 1},
        "artifact_mode": {"enum": ["file", "executable", "directory"]},
        "args": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}
      }
    },
    "requirements": {"$ref": "#/$defs/requirements"},
    "artifact": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": {"enum": ["steam", "http", "http-archive", "github", "local", "custom", "source-build"]},
        "auth": {"enum": ["anonymous", "required"]},
        "package_id": {"type": ["string", "null"]},
        "repository": {"type": ["string", "null"]},
        "tag": {"type": ["string", "null"]},
        "asset": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"]},
        "archive_type": {"type": ["string", "null"]},
        "branch": {"type": ["string", "null"]}
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory"],
      "properties": {
        "directory": {"type": "string", "pattern": "^/"},
        "installer": {"$ref": "#/$defs/installer"}
      }
    },
    "network": {"$ref": "#/$defs/network"},
    "compatibility": {"$ref": "#/$defs/compatibility"},
    "runtime_profile": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "runtime_secrets": {
      "type": "array",
      "items": {"$ref": "#/$defs/runtime_secret"},
      "uniqueItems": true
    }
  },
  "$defs": {
    "installer": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["type", "args"],
      "properties": {
        "type": {"const": "java_jar"},
        "artifact": {"type": ["string", "null"], "pattern": "^[^/\\\\]+$"},
        "args": {"type": "array", "items": {"enum": ["--installServer"]}, "maxItems": 4},
        "timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 1800},
        "launch_args": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["linux_glob", "windows_glob", "output"],
          "properties": {
            "linux_glob": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
            "windows_glob": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
            "output": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
          }
        },
        "expected_outputs": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
        }
      }
    },
    "requirements": {
      "type": "object",
      "required": ["os", "architectures"],
      "properties": {
        "os": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "architectures": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "java": {"type": ["object", "null"], "properties": {"min": {"type": "integer"}, "max": {"type": "integer"}}}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content_ecosystems": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "compatibility_note": {"type": "string", "minLength": 1}
      }
    },
    "runtime_secret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required", "target"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
        "required": {"type": "boolean"},
        "target": {"type": "string", "minLength": 1}
      }
    },
    "network_apply": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "template"],
          "properties": {
            "kind": {"const": "argument"},
            "template": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "file", "key", "value"],
          "properties": {
            "kind": {"const": "property"},
            "file": {"type": "string", "minLength": 1},
            "key": {"type": "string", "minLength": 1},
            "value": {"type": "string"},
            "syntax": {"type": "string", "enum": ["equals", "semicolon"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "port"],
          "properties": {
            "kind": {"const": "derived"},
            "from": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
            "port": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}
          }
        }
      ]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allocation", "block_size", "ports"],
      "properties": {
        "allocation": {"const": "block"},
        "block_size": {"type": "integer", "minimum": 1, "maximum": 65535},
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "protocol", "offset"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
              "protocol": {"enum": ["tcp", "udp"]},
              "offset": {"type": "integer", "minimum": 0, "maximum": 65534},
              "bind_address": {"type": "string", "minLength": 1}
            }
          }
        },
        "apply": {
          "type": "array",
          "items": {"$ref": "#/$defs/network_apply"}
        }
      }
    }
  }
}
