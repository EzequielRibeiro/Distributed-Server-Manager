{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "name"
  ],
  "properties": {
    "schema_version": {
      "const": 2,
      "type": "integer"
    },
    "kind": {
      "const": "GameDefinition"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "pattern": "\\S"
    }
  }
}
