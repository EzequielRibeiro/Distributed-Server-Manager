{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capivara-dsm.local/schemas/v2/network-profile.schema.json",
  "title": "NetworkProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allocation",
    "block_size",
    "ports"
  ],
  "properties": {
    "allocation": {
      "const": "block"
    },
    "block_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "ports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "protocol",
          "offset"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "protocol": {
            "enum": [
              "tcp",
              "udp"
            ]
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65534
          },
          "bind_address": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "apply": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "argument",
              "property"
            ]
          },
          "template": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    }
  }
}
