{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capivara-dsm.local/schemas/runtime-engine-contract.schema.json",
  "title": "RuntimeEngineContract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "kind", "runtime", "engine", "launch"],
  "properties": {
    "contract_version": {"const": 1},
    "kind": {"const": "RuntimeEngineContract"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "game", "edition", "variant", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "game": {"type": "string", "minLength": 1},
        "edition": {"type": "string", "minLength": 1},
        "variant": {"type": "string", "minLength": 1},
        "version": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy"],
          "properties": {
            "strategy": {"enum": ["static", "dynamic"]},
            "resolver": {"type": ["string", "null"]},
            "value": {"type": ["string", "null"]},
            "build": {"type": ["string", "null"]}
          }
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "requirements"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["java", "native", "launcher"]},
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "architectures"],
          "properties": {
            "os": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "architectures": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "java": {
              "type": ["object", "null"],
              "properties": {
                "min": {"type": "integer"},
                "max": {"type": "integer"}
              }
            }
          }
        }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable"],
      "properties": {
        "executable": {"type": "string", "minLength": 1},
        "artifact_mode": {"enum": ["file", "executable", "directory"]},
        "args": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ]
        }
      }
    },
    "artifact": {"type": "object"},
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "source_schema_version"],
      "properties": {
        "source_kind": {"const": "RuntimeDefinition"},
        "source_schema_version": {"const": 2}
      }
    }
  }
}
