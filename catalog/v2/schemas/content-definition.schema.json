{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capivara-dsm.local/schemas/v2/content-definition.schema.json",
  "title": "ContentDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "content_type", "game", "catalog", "compatibility", "dependencies", "conflicts", "artifact"],
  "properties": {
    "schema_version": { "const": 2 },
    "kind": { "const": "ContentDefinition" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "content_type": { "enum": ["mod", "plugin", "modpack"] },
    "game": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "catalog": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "project_id": { "type": ["string", "null"] }
      }
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "game_versions": { "type": "array", "items": { "type": "string" } },
        "editions": { "type": "array", "items": { "type": "string" } },
        "loaders": { "type": "array", "items": { "type": "string" } },
        "loader_versions": { "type": "array", "items": { "type": "string" } },
        "java": { "type": ["object", "null"], "properties": { "min": { "type": "integer" }, "max": { "type": "integer" } } },
        "os": { "type": "array", "items": { "type": "string" } },
        "architectures": { "type": "array", "items": { "type": "string" } }
      }
    },
    "dependencies": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
    "conflicts": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
    "artifact": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "package_id": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "filename": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"] },
        "sha512": { "type": ["string", "null"] },
        "sha1": { "type": ["string", "null"] },
        "workshop_app_id": { "type": ["string", "integer", "null"], "pattern": "^[0-9]+$" },
        "published_file_id": { "type": ["string", "integer", "null"], "pattern": "^[0-9]+$" },
        "collection_id": { "type": ["string", "integer", "null"], "pattern": "^[0-9]+$" },
        "auth": { "enum": ["anonymous", "steam-session", null] }
      },
      "allOf": [
        {
          "if": { "properties": { "provider": { "const": "steam-workshop" } }, "required": ["provider"] },
          "then": {
            "required": ["package_id", "workshop_app_id", "published_file_id"],
            "properties": {
              "package_id": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" }
            }
          }
        }
      ]
    },
    "activation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["adapter"],
      "properties": {
        "adapter": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
        "mode": { "type": ["string", "null"] },
        "identifier": { "type": ["string", "null"] },
        "mount_name": { "type": ["string", "null"] },
        "metadata": { "type": ["object", "null"] }
      }
    }
  },
  "$defs": {
    "relation": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": ["string", "null"] },
        "required": { "type": "boolean" }
      }
    }
  }
}
