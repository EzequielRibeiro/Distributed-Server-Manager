# ============================================================
# Capivara DSM - .gitignore
# Distributed Server Manager
# ============================================================


# ------------------------------------------------------------
# 1. INSTANCIAS E CONTEUDO DE JOGOS
# ------------------------------------------------------------

/instances/
/game-data/


# ------------------------------------------------------------
# 2. BACKUPS GERADOS PELO SISTEMA
# ------------------------------------------------------------

/backups/

# O diretorio backup/ contem CODIGO do sistema.
# Portanto, ignoramos somente artefatos gerados dentro dele.
/backup/**/*.tar
/backup/**/*.tar.gz
/backup/**/*.tgz
/backup/**/*.zip
/backup/**/*.7z


# ------------------------------------------------------------
# 3. EXPORTACOES / IMPORTACOES TEMPORARIAS
# ------------------------------------------------------------

/export/
/import/


# ------------------------------------------------------------
# 4. CACHE
# ------------------------------------------------------------

/cache/


# ------------------------------------------------------------
# 5. LOGS
# ------------------------------------------------------------

/logs/
*.log


# ------------------------------------------------------------
# 6. TEMPORARIOS
# ------------------------------------------------------------

/tmp/
*.tmp
*.temp
*.swp
*.swo
*~
*.lock
*.pid


# ------------------------------------------------------------
# 7. ESTADO OPERACIONAL
# ------------------------------------------------------------

/state/

# Dashboard: scripts permanecem versionados,
# estados JSON gerados ficam fora.
/dashboard/state/*.json
/dashboard/state/*.state
/dashboard/state/*.log


# ------------------------------------------------------------
# 8. RUNTIME
#
# IMPORTANTE:
# runtime/ possui codigo-fonte do Capivara.
# Nao ignorar o diretorio inteiro.
# ------------------------------------------------------------

/runtime/**/*.log
/runtime/**/*.pid
/runtime/**/*.lock
/runtime/**/*.cursor
/runtime/**/*.state
/runtime/**/*.jsonl

/runtime/state/*.json
/runtime/state/**/*.json

/runtime/alerts/
/runtime/backup/
/runtime/collectors/*.json
/runtime/dayz/audit/
/runtime/events/
/runtime/operations/
/runtime/registry/*.json
/runtime/server/
/runtime/mods/state.json

/runtime/archive.json
/runtime/current.json
/runtime/events.json
/runtime/queue.json
/runtime/state.json
/runtime/statistics.json
/runtime/server_worker.state
/runtime/server01_*.state
/runtime/servers


# ------------------------------------------------------------
# 9. DATABASES LOCAIS
# ------------------------------------------------------------

*.db
*.sqlite
*.sqlite3

/config/users.db
/scheduler/jobs.db


# ------------------------------------------------------------
# 10. SEGREDOS / CREDENCIAIS
# ------------------------------------------------------------

.env
.env.*
!.env.example

*.secret
*.secrets
*.key
*.pem
*.p12
*.pfx

/config/discord.secret
/config/dashboard.env
/config/current.conf

/secrets/
/credentials/


# ------------------------------------------------------------
# 11. CONFIGURACOES LOCAIS / DE INSTALACAO
#
# Templates podem e devem permanecer no repositorio.
# ------------------------------------------------------------

/config/*.local
/config/*.test

# Credenciais/configuracoes de usuarios do Dashboard
/dashboard/config/users.conf


# ------------------------------------------------------------
# 12. STEAMCMD
#
# O instalador do Capivara deve permanecer.
# O SteamCMD baixado nao deve ser versionado.
# ------------------------------------------------------------

/tools/steamcmd/

# Mantemos:
# tools/install_steamcmd.sh


# ------------------------------------------------------------
# 13. PYTHON
# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class
*.pyo

.venv/
venv/
env/
ENV/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/


# ------------------------------------------------------------
# 14. IDE / EDITORES
# ------------------------------------------------------------

.idea/
.vscode/

*.code-workspace


# ------------------------------------------------------------
# 15. SISTEMA OPERACIONAL
# ------------------------------------------------------------

.DS_Store
Thumbs.db
desktop.ini


# ------------------------------------------------------------
# 16. ARQUIVOS DE BACKUP CRIADOS DURANTE DESENVOLVIMENTO
# ------------------------------------------------------------

*.bak
*.bak.*
*.bak-*
*.backup
*.backup.*
*.backup-*

# Exemplos do Capivara:
# arquivo.sh.bak-stage31-...
# arquivo.sh.bak-source-...
# arquivo.json.bak-cmake-...


# ------------------------------------------------------------
# 17. MIGRATIONS BACKUP
#
# migrations/ oficial permanece versionado.
# migrations-backup-* nao.
# ------------------------------------------------------------

/database/migrations-backup-*/


# ------------------------------------------------------------
# 18. ARQUIVOS DE TESTE GERADOS
# ------------------------------------------------------------

/test-failure/
/test-http/
/test-http-atomic/


# ------------------------------------------------------------
# 19. ARQUIVOS COMPACTADOS / ARTEFATOS
# ------------------------------------------------------------

*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar
/.artifacts/


# ------------------------------------------------------------
# 20. ARQUIVOS ACIDENTAIS CRIADOS NO SHELL
# ------------------------------------------------------------

/echo
/tail
/watch

# Arquivo acidental criado por colagem de PowerShell
/*watch : The term watch*


# ------------------------------------------------------------
# 21. ARQUIVOS AUXILIARES GERADOS
# ------------------------------------------------------------

/tree.txt


# ------------------------------------------------------------
# 22. ARQUIVOS DE DESENVOLVIMENTO LOCAL
# ------------------------------------------------------------

/commands_dev.txt


# ------------------------------------------------------------
# 23. RELEASE
# ------------------------------------------------------------

# O manifesto faz parte do projeto.
!/release-manifest.json


# ------------------------------------------------------------
# 24. ARQUIVOS QUE DEVEM CONTINUAR VERSIONADOS
# ------------------------------------------------------------

!.gitignore
!.gitattributes
!README.md
!LICENSE
!requirements.txt
!install.sh
!uninstall.sh
!update.sh

# Arquivos auxiliares locais de geração de pacote
[Gg][Ee][Rr][Aa][Rr]_[Zz][Ii][Pp].[Mm][Dd]

# ============================================================
# Capivara DSM - ajustes de dados operacionais
# ============================================================

# Recursos/estado das instancias
/runtime/resources/

# Arquivos auxiliares SQLite
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal

# PID operacional sem extensão
/runtime/pid

# Backups numerados criados durante desenvolvimento
*.bak[0-9]*
