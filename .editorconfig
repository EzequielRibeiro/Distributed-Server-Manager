root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{sh,service,conf,cfg,json,yml,yaml,py,js,css,html,sql}]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[version]
charset = utf-8
end_of_line = lf
insert_final_newline = true